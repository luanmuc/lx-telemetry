{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lx-health-digest",
  "type": "object",
  "required": ["schema", "device", "app", "generated_at", "window_hours", "probe", "play"],
  "properties": {
    "schema": { "const": "lx-health-digest/1" },
    "device": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-f0-9]{8,32}$" },
        "model": { "type": "string", "maxLength": 80 },
        "android": { "type": "string", "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "maxLength": 32 },
        "build": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "version": { "type": "string", "maxLength": 32 }
      },
      "additionalProperties": false
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "window_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
    "probe": {
      "type": "object",
      "required": ["total", "ok"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "ok": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["total", "ok"],
            "properties": {
              "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
              "ok": { "type": "integer", "minimum": 0, "maximum": 2000 }
            },
            "additionalProperties": false
          }
        },
        "by_quality": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["total", "ok"],
            "properties": {
              "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
              "ok": { "type": "integer", "minimum": 0, "maximum": 2000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "play": {
      "type": "object",
      "required": ["total", "ok"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "ok": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["total", "ok"],
            "properties": {
              "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
              "ok": { "type": "integer", "minimum": 0, "maximum": 2000 }
            },
            "additionalProperties": false
          }
        },
        "by_quality": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["total", "ok"],
            "properties": {
              "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
              "ok": { "type": "integer", "minimum": 0, "maximum": 2000 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "chain": {
      "type": "object",
      "required": ["total", "ok"],
      "properties": {
        "total": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "ok": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "failures": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["source", "code"],
            "properties": {
              "source": { "type": "string", "maxLength": 40 },
              "code": { "type": "string", "maxLength": 40 },
              "at": { "type": "string", "maxLength": 40 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "breaker": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "state": { "type": "string", "maxLength": 20 },
          "fail": { "type": "integer", "minimum": 0, "maximum": 9999 }
        },
        "additionalProperties": false
      }
    },
    "recent_events": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["at", "kind"],
        "properties": {
          "at": { "type": "string", "maxLength": 40 },
          "kind": { "type": "string", "maxLength": 40 },
          "source": { "type": "string", "maxLength": 40 },
          "code": { "type": "string", "maxLength": 40 },
          "q": { "type": "string", "maxLength": 12 },
          "ms": { "type": "integer", "minimum": 0, "maximum": 999999 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
